# Local development only. setup.mjs replaces these placeholders with random values.
POSTGRES_USER=oj
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=oj
# Host port; PostgreSQL still listens on 5432 inside its container.
POSTGRES_PORT=15432
REDIS_PORT=6379
MINIO_ROOT_USER=oj_local
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_ADDR=127.0.0.1:8080
# Optional for host API readiness; replace password with POSTGRES_PASSWORD.
# DATABASE_URL=postgres://oj:REPLACE_ME@127.0.0.1:15432/oj?sslmode=disable

# Compile-only service; defaults to this address when not set.
COMPILER_URL=http://127.0.0.1:8081
# API and judge must share this local demonstration upload catalog.
PROBLEM_UPLOAD_ROOT=.local/teacher-problems
